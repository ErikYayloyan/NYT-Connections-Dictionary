{
  "manifest_version": 3,
  "name": "Connections Dictionary",
  "version": "0.1.0",
  "description": "Click a word in NYT Connections to see its definition without leaving the game.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connections Dictionary",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/connections*",
        "https://www.nytimes.com/crosswords/game/connections*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
